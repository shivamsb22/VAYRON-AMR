    <!-- ================================================= -->

    <model name="office_desk_1">
      <static>true</static><pose>-5 12 0.65 0 0 0</pose>
      <link name="desk">
        <collision name="c"><geometry><box><size>2.4 1.2 1.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.4 1.2 1.3</size></box></geometry>
          <material><ambient>0.45 0.30 0.18 1</ambient></material></visual>
