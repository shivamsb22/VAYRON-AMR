    <!-- ================================================= -->
    <!-- ADDITIONAL CORRIDOR OBSTACLES                     -->
    <!-- ================================================= -->

    <model name="corridor_plant_1">
      <static>true</static><pose>-6 0 0.5 0 0 0</pose>
      <link name="pot">
