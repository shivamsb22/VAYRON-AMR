    </model>

    <model name="office_chair_2">
      <static>true</static><pose>5 10 0.45 0 0 0</pose>
      <link name="chair">
        <collision name="c"><geometry><box><size>0.7 0.7 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.9</size></box></geometry>
          <material><ambient>0.10 0.14 0.20 1</ambient></material></visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- ROOM 3: LOUNGE / SOFAS / COFFEE TABLE             -->
    <!-- ================================================= -->

    <model name="lounge_sofa">
      <static>true</static><pose>15 12 0.5 0 0 0</pose>
      <link name="sofa">
        <collision name="c"><geometry><box><size>4 1.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4 1.2 1</size></box></geometry>
          <material><ambient>0.22 0.24 0.27 1</ambient></material></visual>
      </link>
    </model>

    <model name="lounge_sofa_2">
      <static>true</static><pose>16 7 0.5 0 0 1.5708</pose>
      <link name="sofa">
        <collision name="c"><geometry><box><size>3 1.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 1.2 1</size></box></geometry>
          <material><ambient>0.22 0.24 0.27 1</ambient></material></visual>
      </link>
    </model>

    <model name="lounge_coffee_table">
      <static>true</static><pose>12 9 0.3 0 0 0</pose>
      <link name="table">
        <collision name="c"><geometry><box><size>1.8 1.2 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 1.2 0.6</size></box></geometry>
          <material><ambient>0.38 0.25 0.15 1</ambient></material></visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- ROOM 4: KITCHEN / CABINETS                        -->
    <!-- ================================================= -->

    <model name="kitchen_counter">
      <static>true</static><pose>15 -9 0.5 0 0 0</pose>
      <link name="counter">
        <collision name="c"><geometry><box><size>5 1.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 1.2 1</size></box></geometry>
          <material><ambient>0.60 0.60 0.58 1</ambient></material></visual>
      </link>
    </model>

    <model name="kitchen_island">
      <static>true</static><pose>13 -12 0.55 0 0 0</pose>
      <link name="island">
        <collision name="c"><geometry><box><size>3 1.5 1.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 1.5 1.1</size></box></geometry>
          <material><ambient>0.35 0.36 0.38 1</ambient></material></visual>
      </link>
