<?xml version="1.0"?>
<sdf version="1.6">
  <world name="vayron_indoor_test_facility">

    <!-- ================================================= -->
    <!-- ENVIRONMENT AND PHYSICS                           -->
    <!-- ================================================= -->

    <include>
      <uri>model://sun</uri>
    </include>

    <physics name="indoor_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.72 0.79 0.87 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================================================= -->
    <!-- SINGLE LEVEL FLOOR: 40m x 30m                     -->
    <!-- Floor top surface is z=0                          -->
    <!-- ================================================= -->

    <model name="facility_floor">
      <static>true</static>
      <pose>0 0 -0.10 0 0 0</pose>
      <link name="floor">
        <collision name="collision">
          <geometry>
            <box><size>40 30 0.20</size></box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box><size>40 30 0.20</size></box>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.68 1</ambient>
            <diffuse>0.72 0.72 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- OUTER WALLS: 3m HIGH                              -->
    <!-- All walls have their bottom at z=0                -->
    <!-- ================================================= -->

    <model name="outer_wall_north">
      <static>true</static><pose>0 15 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>40 0.20 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>40 0.20 3</size></box></geometry>
          <material><ambient>0.72 0.74 0.77 1</ambient></material></visual>
      </link>
    </model>

    <model name="outer_wall_south">
      <static>true</static><pose>0 -15 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>40 0.20 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>40 0.20 3</size></box></geometry>
          <material><ambient>0.72 0.74 0.77 1</ambient></material></visual>
      </link>
    </model>

    <model name="outer_wall_west">
      <static>true</static><pose>-20 0 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.20 30 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.20 30 3</size></box></geometry>
          <material><ambient>0.72 0.74 0.77 1</ambient></material></visual>
      </link>
    </model>

    <model name="outer_wall_east">
      <static>true</static><pose>20 0 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.20 30 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.20 30 3</size></box></geometry>
          <material><ambient>0.72 0.74 0.77 1</ambient></material></visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- CENTRAL CORRIDOR: y=-2 to y=2                     -->
    <!-- Main room entrances leave 1.6m gaps               -->
    <!-- ================================================= -->

    <!-- North partition, with door gaps -->
    <model name="north_wall_west">
      <static>true</static><pose>-15 4 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>10 0.18 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.18 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <model name="north_wall_middle">
      <static>true</static><pose>0 4 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>8 0.18 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.18 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <model name="north_wall_east">
      <static>true</static><pose>13 4 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>10 0.18 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.18 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <!-- South partition, with door gaps -->
    <model name="south_wall_west">
      <static>true</static><pose>-15 -4 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>10 0.18 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.18 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <model name="south_wall_middle">
      <static>true</static><pose>0 -4 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>8 0.18 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.18 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <model name="south_wall_east">
      <static>true</static><pose>13 -4 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>10 0.18 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.18 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- ROOM DIVIDERS: EACH ROOM HAS DOORWAY GAPS         -->
    <!-- ================================================= -->

    <!-- North rooms: x=-10, 0, 10 boundaries -->
    <model name="north_divider_west">
      <static>true</static><pose>-10 9.5 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.18 11 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.18 11 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <model name="north_divider_east">
      <static>true</static><pose>10 9.5 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.18 11 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.18 11 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <!-- South rooms -->
    <model name="south_divider_west">
      <static>true</static><pose>-10 -9.5 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.18 11 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.18 11 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <model name="south_divider_east">
      <static>true</static><pose>10 -9.5 1.5 0 0 0</pose>
      <link name="wall">
        <collision name="c"><geometry><box><size>0.18 11 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.18 11 3</size></box></geometry>
          <material><ambient>0.65 0.67 0.70 1</ambient></material></visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- ROOM 1: CONFERENCE / TABLES                       -->
    <!-- ================================================= -->

    <model name="conference_table">
      <static>true</static><pose>-15 9 0.75 0 0 0</pose>
      <link name="table">
        <collision name="c"><geometry><box><size>5 2 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 2 1.5</size></box></geometry>
          <material><ambient>0.42 0.25 0.12 1</ambient></material></visual>
      </link>
    </model>

    <model name="conference_chair_1">
      <static>true</static><pose>-18 6.8 0.45 0 0 0</pose>
      <link name="chair">
        <collision name="c"><geometry><box><size>0.7 0.7 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.9</size></box></geometry>
          <material><ambient>0.12 0.14 0.17 1</ambient></material></visual>
      </link>
    </model>

    <model name="conference_chair_2">
      <static>true</static><pose>-15 6.8 0.45 0 0 0</pose>
      <link name="chair">
        <collision name="c"><geometry><box><size>0.7 0.7 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.9</size></box></geometry>
          <material><ambient>0.12 0.14 0.17 1</ambient></material></visual>
      </link>
    </model>

    <model name="conference_chair_3">
      <static>true</static><pose>-12 6.8 0.45 0 0 0</pose>
      <link name="chair">
        <collision name="c"><geometry><box><size>0.7 0.7 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.9</size></box></geometry>
          <material><ambient>0.12 0.14 0.17 1</ambient></material></visual>
      </link>
    </model>

    <!-- ================================================= -->
